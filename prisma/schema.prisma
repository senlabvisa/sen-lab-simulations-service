generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["simulations_svc"]
}

model Simulation {
  id             String   @id @default(uuid())
  title          String
  subject        String
  targetGrade    String
  slug           String   @unique
  rubricTemplate Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("simulations")
  @@schema("simulations_svc")
}
